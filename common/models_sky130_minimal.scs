// =============================================================================
// Minimal Open-Source SkyWater 130 nm (sky130) BSIM4.5 Model Subset (TT Corner)
// =============================================================================
// Upstream: google/skywater-pdk-libs-sky130_fd_pr (silicon-calibrated TT corner)
// License:  Apache License, Version 2.0
//           Copyright 2020 The SkyWater PDK Authors
//           https://www.apache.org/licenses/LICENSE-2.0
//
// Included silicon-calibrated 1.8 V planar CMOS BSIM4.5 devices (TT, 5 L-bins
// covering L = 0.14 um .. 100 um for W = 0.36 um .. 1000 um, extracted from
// official W=[3..5 um] TT bins with mc_mm_switch=0, mc_pr_switch=0):
//   - `sky130_fd_pr__nfet_01v8`  (alias: `sky130_nch`)  1.8 V NMOS (L_min = 0.15 um)
//   - `sky130_fd_pr__pfet_01v8`  (alias: `sky130_pch`)  1.8 V PMOS (L_min = 0.15 um)
//
// Usage in Spectre (`simulator lang=spectre`):
//   include "models_sky130_minimal.scs"
//   M1 (d g s b) sky130_fd_pr__nfet_01v8 w=2u l=0.15u
//   M2 (d g s b) sky130_fd_pr__pfet_01v8 w=4u l=0.15u
//
// Note: Minimal self-contained TT subset for SAR ADC, OpAmp, LDO, Bandgap, and
// mixed-signal verification. Use the full SkyWater PDK for PVT/Monte Carlo signoff.
// =============================================================================

simulator lang=spice

